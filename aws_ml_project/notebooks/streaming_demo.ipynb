    "import matplotlib.pyplot as plt\n",
    "from collections import Counter\n",
    "\n",
    "def process_and_visualize(df, delay=0.5, max_events=50):\n",
    "    label_counts = Counter()\n",
    "    plt.ion()\n",
    "    fig, ax = plt.subplots()\n",
    "    for idx, row in df.iterrows():\n",
    "        label = row.get('label', None) or row.get('sentiment', None)\n",
    "        if label is not None:\n",
    "            label_counts[label] += 1\n",
    "        ax.clear()\n",
    "        ax.bar(label_counts.keys(), label_counts.values())\n",
    "        ax.set_title('Running Label Counts')\n",
    "        plt.draw()\n",
    "        plt.pause(0.01)\n",
    "        time.sleep(delay)\n",
    "        if idx + 1 >= max_events:\n",
    "            break\n",
    "    plt.ioff()\n",
    "    plt.show()\n",
    "\n",
    "# Example: visualize running label counts for first 50 events\n",
    "process_and_visualize(df, delay=0.2, max_events=50)"
   ]
  },
