    "import time\n",
    "\n",
    "def simulate_streaming(df, delay=0.5, max_events=10):\n",
    "    \"\"\"Simulate streaming by sending each row as an event with a delay.\"\"\"\n",
    "    for idx, row in df.iterrows():\n",
    "        event = row.to_dict()\n",
    "        print(f'[EVENT {idx}] {event}')  # Replace with Kinesis put_record if needed\n",
    "        time.sleep(delay)\n",
    "        if idx + 1 >= max_events:\n",
    "            break\n",
    "\n",
    "# Simulate streaming first 10 events (adjust max_events as needed)\n",
    "simulate_streaming(df, delay=0.5, max_events=10)"
   ]
