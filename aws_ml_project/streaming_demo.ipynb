    "import pandas as pd\n",
    "import time\n",
    "import matplotlib.pyplot as plt\n",
    "from collections import Counter\n",
    "\n",
    "data_path = '../../02_ml_basics/data/ratings_train.txt'  # Adjust as needed\n",
    "try:\n",
    "    df = pd.read_csv(data_path, sep='\\t', encoding='utf-8')\n",
    "except Exception:\n",
    "    df = pd.read_csv(data_path, sep=',', encoding='utf-8')\n",
    "\n",
    "def simulate_streaming(df, delay=0.2, max_events=20):\n",
    "    label_counts = Counter()\n",
    "    plt.ion()\n",
    "    fig, ax = plt.subplots()\n",
    "    for idx, row in df.iterrows():\n",
    "        label = row.get('label', None) or row.get('sentiment', None)\n",
    "        if label is not None:\n",
    "            label_counts[label] += 1\n",
    "        ax.clear()\n",
    "        ax.bar(label_counts.keys(), label_counts.values())\n",
    "        ax.set_title('Running Label Counts')\n",
    "        plt.draw()\n",
    "        plt.pause(0.01)\n",
    "        print(f'[EVENT {idx}] {row.to_dict()}')\n",
    "        time.sleep(delay)\n",
    "        if idx + 1 >= max_events:\n",
    "            break\n",
    "    plt.ioff()\n",
    "    plt.show()\n",
    "\n",
    "simulate_streaming(df, delay=0.2, max_events=20)"
   ]
  },
