    "import boto3\n",
    "dynamodb = boto3.client('dynamodb', region_name='ap-southeast-2')\n",
    "table_name = 'oreumi-naver-review-agg'\n",
    "\n",
    "# Example PartiQL insert\n",
    "partiql = (\"INSERT INTO \", table_name, \" VALUE {'pk':'test', 'sk':'2025-11-23T00:00:00', 'label':'positive', 'ttl':\", 1701302400, \"}\")\n",
    "response = dynamodb.execute_statement(Statement=' '.join(partiql))\n",
    "print('Insert response:', response)"
