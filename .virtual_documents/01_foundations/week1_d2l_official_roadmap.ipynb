# Load and preprocess
df = pd.read_csv(os.path.join(data_dir, 'employees.csv'))
print("Original employee data:")
print(df)
print("\nMissing values per column:")
print(df.isnull().sum())


# Your task: Preprocess this data
# 1. Fill missing ages with the median age
median_age = df['Age'].median()
df['Age'].fillna(median_age, inplace=True)

# 2. Fill missing salaries with the mean salary
mean_salary = df['Salary'].mean()
df['Salary'].fillna(mean_salary, inplace=True)

# 3. Convert categorical variables to dummy variables
df_processed = pd.get_dummies(df, columns=['City', 'Department'], dummy_na=True)

print("\nProcessed data:")
print(df_processed)

# 4. Convert to tensors (excluding Name column)
features = df_processed.drop('Name', axis=1)
feature_tensor = torch.tensor(features.values, dtype=torch.float32)
print(f"\nFeature tensor shape: {feature_tensor.shape}")
print(f"First row features: {feature_tensor[0]}")





# Simulate a simple neural network computation
# Input: 3 features for 5 samples
X = torch.tensor([
    [1.0, 2.0, 3.0],  # Sample 1
    [4.0, 5.0, 6.0],  # Sample 2  
    [7.0, 8.0, 9.0],  # Sample 3
    [2.0, 3.0, 4.0],  # Sample 4
    [5.0, 6.0, 7.0]   # Sample 5
])

# Weights for a simple linear layer (3 inputs -> 2 outputs)
W = torch.tensor([
    [0.1, 0.2],   # Weights for input 1
    [0.3, 0.4],   # Weights for input 2
    [0.5, 0.6]    # Weights for input 3
])

# Bias terms
b = torch.tensor([0.1, 0.2])

print(f"Input X shape: {X.shape}")
print(f"Weights W shape: {W.shape}")
print(f"Bias b shape: {b.shape}")

# Forward pass: Y = XW + b
Y = torch.mm(X, W) + b
print(f"\nOutput Y shape: {Y.shape}")
print(f"Output Y:\n{Y}")

# Calculate some statistics
print(f"\nMean output per feature: {Y.mean(dim=0)}")
print(f"L2 norm of first sample output: {torch.norm(Y[0])}")



