# Sample Environment File for AI-Track
# Copy this to D:/repos/tonylee/goorm/ai-track/.env and fill in your credentials

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_here

# Hugging Face
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_HUB_TOKEN=your_huggingface_token_here

# GitHub
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username

# Notion API
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# AWS (for Amazon services)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-west-2

# Azure OpenAI (alternative to OpenAI)
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_API_VERSION=2024-02-01

# Weights & Biases (experiment tracking)
WANDB_API_KEY=your_wandb_api_key

# Google Cloud (for Google AI services)
GOOGLE_APPLICATION_CREDENTIALS=/workspace/ai-track/google-credentials.json
GOOGLE_CLOUD_PROJECT=your_project_id

# Language and Locale Settings
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
LANGUAGE=en_US:ko_KR:en

# CUDA Settings
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=all

# Jupyter Settings
JUPYTER_ENABLE_LAB=yes
JUPYTER_TOKEN=""
JUPYTER_PASSWORD=""