# .env.mlu TEMPLATE for MLU Projects
# Copy this file to your project root and update values as needed.


# AWS IAM user credentials ONLY (never use root credentials)
# Use an IAM user with minimum S3 permissions. Do NOT use root credentials.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=ap-northeast-2

# Jupyter and project settings
JUPYTER_TOKEN=mlu2025
COMPOSE_PROJECT_NAME=mlu
DOCKER_BUILDKIT=1

